# ---------------------------------------------------------------
# HealthRisk AI environment variables. Copy to `.env` (never commit secrets).
# No secrets are required by this project.
# ---------------------------------------------------------------

# Frontend (Next.js) - public, embedded at build time
NEXT_PUBLIC_API_BASE_URL=          # empty = same origin (/api routed by vercel.json Services)
NEXT_PUBLIC_APP_ENV=development
API_PROXY_TARGET=http://127.0.0.1:8000   # local dev only: where `next dev` proxies /api/*

# Backend (FastAPI)
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000    # comma-separated; only needed if the API is on another origin
# HEALTHRISK_ARTIFACTS=backend/artifacts # override the model artefact directory

# Training (optional) - Kaggle API credentials for `python -m ml.data_ingestion --download`
# KAGGLE_USERNAME=
# KAGGLE_KEY=
